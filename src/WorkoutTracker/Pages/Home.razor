@page "/"
@inject WorkoutService Data
@inject NavigationManager Nav

<PageTitle>RepLog</PageTitle>

<header class="hero">
    <div>
        <p class="eyebrow">@Now.ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture)</p>
        <h1>@Greeting</h1>
    </div>
</header>

<section class="card goal-card">
    <ProgressRing Value="@((double)_thisWeek / Data.Settings.WeeklyGoal)" Size="92">
        <strong>@_thisWeek</strong><small>/ @Data.Settings.WeeklyGoal</small>
    </ProgressRing>
    <div class="grow">
        <div class="row-title">Weekly goal</div>
        <p class="muted small">@GoalMessage</p>
        @if (Data.ActiveWorkout is { } active)
        {
            <a class="btn btn-primary" href="workout/@active.Id"><Icon Name="play" Size="18" /> Resume workout</a>
        }
        else
        {
            <button class="btn btn-primary" @onclick="() => Start(null)"><Icon Name="play" Size="18" /> Start workout</button>
        }
    </div>
</section>

<div class="stat-grid">
    <StatTile IconName="flame" Value="@_streak.ToString()" Label="Week streak" Accent="@(_streak > 0)" />
    <StatTile IconName="bolt" Value="@Fmt.Volume(_weekVolume, Data.Unit)" Label="This week" />
    <StatTile IconName="calendar" Value="@Data.History.Count.ToString()" Label="Total workouts" />
</div>

@if (_templates.Count > 0 && Data.ActiveWorkout is null)
{
    <h2 class="section-title">Repeat a workout</h2>
    <div class="h-scroll">
        @foreach (var t in _templates)
        {
            <button class="card template-card" @onclick="() => Start(t)">
                <span class="template-icon"><Icon Name="repeat" Size="18" /></span>
                <span class="row-title">@t.Name</span>
                <span class="row-sub">@t.Exercises.Count exercises · @Fmt.RelativeDay(t.StartedAt, Now)</span>
            </button>
        }
    </div>
}

<section class="card">
    <div class="card-head">
        <h2>Volume</h2>
        <span class="muted small">Last 8 weeks</span>
    </div>
    <BarChart Points="_volumePoints" AriaLabel="Weekly training volume" />
</section>

<div class="section-head">
    <h2 class="section-title">Recent workouts</h2>
    @if (Data.History.Count > 0)
    {
        <a class="link" href="history">See all</a>
    }
</div>
@if (Data.History.Count == 0)
{
    <div class="empty">
        <div class="empty-icon"><Icon Name="dumbbell" Size="32" /></div>
        <h3>No workouts yet</h3>
        <p class="muted">Start your first workout and it will show up here.</p>
    </div>
}
else
{
    <div class="stack">
        @foreach (var w in Data.History.Take(3))
        {
            <WorkoutCard Workout="w" Now="Now" Unit="Data.Unit" />
        }
    </div>
}

@code {
    private DateTime Now => Data.Now;
    private int _thisWeek, _streak;
    private double _weekVolume;
    private IReadOnlyList<Workout> _templates = [];
    private IReadOnlyList<ChartPoint> _volumePoints = [];

    private string Greeting => Now.Hour < 5 ? "Late night grind" : Now.Hour < 12 ? "Good morning" : Now.Hour < 17 ? "Good afternoon" : "Good evening";

    private string GoalMessage
    {
        get
        {
            var left = Data.Settings.WeeklyGoal - _thisWeek;
            return left <= 0 ? "Goal smashed this week. Nice work! 🎉"
                : _thisWeek == 0 ? $"{left} workouts to hit your goal this week."
                : $"{left} more to go — keep it up.";
        }
    }

    protected override void OnInitialized()
    {
        var history = Data.History;
        var weeks = Stats.Weekly(history, Now, 8);
        _thisWeek = weeks[^1].Workouts;
        _weekVolume = weeks[^1].Volume;
        _streak = Stats.WeekStreak(history, Now);
        _templates = Data.RecentTemplates();
        _volumePoints = weeks.Select(w => new ChartPoint(
            w.WeekStart.ToString("M/d", System.Globalization.CultureInfo.InvariantCulture),
            Units.ToDisplayWeight(w.Volume, Data.Unit),
            Fmt.Volume(w.Volume, Data.Unit))).ToList();
    }

    private async Task Start(Workout? template)
    {
        var w = await Data.StartWorkoutAsync(template);
        Nav.NavigateTo($"workout/{w.Id}");
    }
}
