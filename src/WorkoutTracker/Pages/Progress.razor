@page "/progress"
@inject WorkoutService Data

<PageTitle>Progress · RepLog</PageTitle>

<header class="hero"><h1>Progress</h1></header>

@{
    var history = Data.History;
    var weeks = Stats.Weekly(history, Data.Now, 12);
    var split = Stats.MuscleSplit(history, Data.Now.Date.AddDays(-30));
    var records = Stats.AllRecords(history);
    var totalTime = TimeSpan.FromTicks(history.Sum(w => Stats.Duration(w, Data.Now).Ticks));
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="stat-grid">
    <StatTile IconName="calendar" Value="@history.Count.ToString()" Label="Workouts" Accent="true" />
    <StatTile IconName="bolt" Value="@Fmt.Volume(history.Sum(Stats.Volume), Data.Unit)" Label="Total volume" />
    <StatTile IconName="timer" Value="@Fmt.Duration(totalTime)" Label="Time trained" />
</div>

<section class="card">
    <div class="card-head">
        <h2>Workouts per week</h2>
        <span class="muted small">Last 12 weeks</span>
    </div>
    <BarChart ShowValues="true" AriaLabel="Workouts per week"
              Points="@weeks.Select(w => new ChartPoint(w.WeekStart.ToString("M/d", inv), w.Workouts, w.Workouts.ToString())).ToList()" />
</section>

<section class="card">
    <div class="card-head">
        <h2>Muscle focus</h2>
        <span class="muted small">Sets · last 30 days</span>
    </div>
    @if (split.Count == 0)
    {
        <p class="muted">Complete some sets to see your split.</p>
    }
    else
    {
        var max = split.Max(s => s.Sets);
        <div class="hbars">
            @foreach (var (muscle, sets) in split)
            {
                <div class="hbar-row">
                    <span class="hbar-label">@Fmt.MuscleName(muscle)</span>
                    <div class="hbar-track"><div class="hbar" style="width:@((sets * 100.0 / max).ToString("0.#", inv))%"></div></div>
                    <span class="hbar-value">@sets</span>
                </div>
            }
        </div>
    }
</section>

<h2 class="section-title">Personal records</h2>
@if (records.Count == 0)
{
    <div class="empty">
        <div class="empty-icon"><Icon Name="trophy" Size="32" /></div>
        <h3>No records yet</h3>
        <p class="muted">Your best lifts will be celebrated here.</p>
    </div>
}
else
{
    <ul class="list card flush">
        @foreach (var r in records)
        {
            <li>
                <a class="list-row" href="exercises/@r.ExerciseId">
                    <span class="avatar trophy"><Icon Name="trophy" Size="18" /></span>
                    <span class="grow">
                        <span class="row-title">@r.Name</span>
                        <span class="row-sub">@r.Sessions session@(r.Sessions == 1 ? "" : "s") · @Fmt.RelativeDay(r.AchievedAt, Data.Now)</span>
                    </span>
                    <span class="pr-value">@RecordText(r)</span>
                </a>
            </li>
        }
    </ul>
}

@code {
    private string RecordText(PersonalRecord r) => r.Type switch
    {
        ExerciseType.Cardio => r.LongestKm > 0 ? Fmt.Distance(r.LongestKm, Data.Unit) : Fmt.Clock(TimeSpan.FromSeconds(r.LongestSeconds)),
        ExerciseType.Bodyweight => $"{r.MaxReps} reps",
        _ => Fmt.Weight(r.BestOneRepMax, Data.Unit) + " 1RM"
    };
}
